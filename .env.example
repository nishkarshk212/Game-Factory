# Server Configuration
NODE_ENV=development
PORT=3001
PUBLIC_WEBAPP_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,https://t.me,https://web.telegram.org

# Telegram Bot & Mini App Configuration
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=GameVerseSonicBot
TELEGRAM_MINI_APP_SHORT_NAME=gameverse

# Security & Auth
# Must be changed to a strong 32+ char random secret in production
JWT_SECRET=gameverse-sonic-network-dev-secret-change-me
# Allow browser demo/dev authentication when running outside Telegram (set false in strict prod)
ALLOW_DEV_AUTH=true
# Comma-separated Telegram IDs to auto-promote to Admin role
ADMIN_TELEGRAM_IDS=100001

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gameverse

# Redis 7+ (Matchmaking & Live Match Synchronization)
REDIS_URL=redis://localhost:6379
# Development resilience fallback if Redis daemon isn't running locally
ALLOW_IN_MEMORY_REDIS_FALLBACK=true

